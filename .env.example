# ==============================================================================
# knowthankyew Enterprise Self-Host Suite - Environment Configuration
# Copy this file to .env and adjust as needed for your organization.
# ==============================================================================

# Gateway & Portal Port
PORTAL_PORT=8080

# Individual Direct Ports (Optional)
LEASE_AUDIT_PORT=8081
CARE_CHECK_PORT=8082
PAYSTUB_CHECK_PORT=8083
BILL_OF_RIGHTS_PORT=8084
WARRANTY_WATCH_PORT=8085
GRADCAST_PORT=5062
MAIL_STRIPPER_PORT=5001
FTAAS_API_PORT=5005
MLFLOW_PORT=5002
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Telemetry Configuration
# In consumer mode, leave blank to eliminate telemetry code at build time.
# In enterprise mode, point to the gateway proxy or local collector.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8080/otlp/v1/traces
BACKEND_OTLP_ENDPOINT=http://otel-collector:4317

# RabbitMQ Credentials
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Surprisal Preflight Arbiter (bound strictly to 127.0.0.1)
SURPRISAL_PORT=5200

# Genesis Volatile Log Engine (bound strictly to 127.0.0.1 + mandatory bearer token)
GENESIS_PORT=9002
# Note: TCP port 9000 is commonly used by MinIO, Portainer, and PHP-FPM; override if needed.
GENESIS_TCP_PORT=9000
# Required before running docker compose up or burn-telemetry.sh:
# export GENESIS_AUTH_TOKEN=$(openssl rand -hex 32)
# GENESIS_AUTH_TOKEN=

# Optional shared secret for FTaaS adapter_path HMAC-SHA256 correlation across API & Worker
# (kept strictly out of otel-collector so the collector never holds the key):
# FTAAS_TELEMETRY_HMAC_KEY=
