# ==============================================================================
# knowthankyew Enterprise Self-Host Suite - Environment Configuration
# Copy this file to .env and adjust as needed for your organization.
# ==============================================================================

# Gateway & Portal Port
PORTAL_PORT=8080

# Individual Direct Ports (Optional)
LEASE_AUDIT_PORT=8081
CARE_CHECK_PORT=8082
PAYSTUB_CHECK_PORT=8083
BILL_OF_RIGHTS_PORT=8084
WARRANTY_WATCH_PORT=8085
GRADCAST_PORT=5062
MAIL_STRIPPER_PORT=5001
FTAAS_API_PORT=5000
MLFLOW_PORT=5002
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Telemetry Configuration
# In consumer mode, leave blank to eliminate telemetry code at build time.
# In enterprise mode, point to the gateway proxy or local collector.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8080/otlp/v1/traces
BACKEND_OTLP_ENDPOINT=http://otel-collector:4317

# RabbitMQ Credentials
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
